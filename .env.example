# maak — environment variables
# No secrets required. Copy to .env for local dev; production values are set on the host.

# ── Frontend (Vite, build-time) ──
# Base URL of the providers API used by the PRODUCTION frontend build.
# EMPTY for local dev (Vite proxies /api → MAAK_API_TARGET).
# For production set to the public backend URL, e.g. https://maak-api.fly.dev
VITE_API_URL=
# Vite dev proxy target:
MAAK_API_TARGET=http://localhost:8787

# ── Backend (Node, runtime) ──
# Port the API listens on. Fly.io uses MAAK_PORT; Heroku/Render/Railway inject PORT.
PORT=8787
MAAK_PORT=8787
# SQLite database file path. On Fly.io point this at the persistent volume:
#   MAAK_DB_PATH=/data/maak.db
MAAK_DB_PATH=server/data/maak.db
# CORS: the published frontend origin (default is the GitHub Pages site).
MAAK_ALLOW_ORIGIN=https://i36508871-eng.github.io
