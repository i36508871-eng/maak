# maak — environment variables (Cloudflare Worker + Supabase REST)
# No secrets here. Worker secrets are set with wrangler secret put (never committed).

# ── Frontend (Vite, build-time) ──
# Base URL of the providers API used by the PRODUCTION frontend build.
# EMPTY for local dev (Vite proxies /api to MAAK_API_TARGET, i.e. wrangler dev).
# For production set to the public Worker URL, e.g. https://maak-api.<sub>.workers.dev
VITE_API_URL=
MAAK_API_TARGET=http://localhost:8787

# ── Supabase Auth (frontend — publishable key only, NEVER the service_role key) ──
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# ── Worker secrets (set via wrangler secret put; see DEPLOY.md) ──
# SUPABASE_URL               = https://<project>.supabase.co   (SECRET)
# SUPABASE_SERVICE_ROLE_KEY  = <service_role key>             (SECRET — bypasses RLS)
# ADMIN_TOKEN                = <random string>                (SECRET — protects POST /admin/seed)
# MAAK_ALLOW_ORIGIN          = https://i36508871-eng.github.io (VAR in wrangler.jsonc)
