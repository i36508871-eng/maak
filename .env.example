# maak — environment variables (Sprint 4A: PostgreSQL via Supabase)
# No secrets here. Production values are set on the host (Render / Supabase).

# ── Frontend (Vite, build-time) ──
# Base URL of the providers API used by the PRODUCTION frontend build.
# EMPTY for local dev (Vite proxies /api → MAAK_API_TARGET).
# For production set to the public backend URL, e.g. https://maak-api.onrender.com
VITE_API_URL=
MAAK_API_TARGET=http://localhost:8787

# ── Backend (Node, runtime) ──
# Port the API listens on. Render injects PORT automatically.
PORT=8787
MAAK_PORT=8787
# PostgreSQL connection string (Supabase). NEVER commit the real value.
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXXXX.supabase.co:5432/postgres
# CORS: the published frontend origin (default is the GitHub Pages site).
MAAK_ALLOW_ORIGIN=https://i36508871-eng.github.io
