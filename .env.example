# maak — environment variables (Sprint 3)
# Copy to .env and adjust as needed. No secrets are required for local dev.

# Frontend (read by Vite at build time):
#   Base URL of the providers API for the production build.
#   Leave EMPTY for local dev — Vite proxies /api to the backend.
VITE_API_URL=

# Frontend dev proxy target (Vite config):
MAAK_API_TARGET=http://localhost:8787

# Backend (Node, runtime):
#   Port the API server listens on.
MAAK_PORT=8787
#   Path to the SQLite database file.
MAAK_DB_PATH=server/data/maak.db
#   CORS origin to allow (use * for any, or your published frontend URL).
MAAK_ALLOW_ORIGIN=*
