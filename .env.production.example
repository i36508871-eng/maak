# Copy to .env.production and set the public Worker URL + Supabase publishable key.
# Vite auto-loads .env.production during vite build, so the GitHub Pages build
# picks up the public API with NO workflow changes. These are PUBLIC values, not secrets.
VITE_API_URL=https://maak.<your-sub>.workers.dev
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
